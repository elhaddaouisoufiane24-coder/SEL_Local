# ---- Sito ----
# URL pubblico (senza slash finale). In locale: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.autoinspecta.it

# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SOLO lato server. Mai nel browser, mai in NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Stripe (usa sk_test_ finche' non vai live) ----
STRIPE_SECRET_KEY=sk_test_...
# Signing secret del webhook /api/stripe/webhook (whsec_...). Test e live ne hanno uno ciascuno.
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Cal.com ----
# Slug del tipo di evento: "username/slug-evento" (es. autoinspecta/ispezione)
NEXT_PUBLIC_CALCOM_LINK=username/slug-evento
# Secret scelto da te nel webhook Cal.com (/api/calcom/webhook)
CALCOM_WEBHOOK_SECRET=...

# ---- Email (Resend) ----
RESEND_API_KEY=re_...
# Mittente su dominio verificato in Resend
EMAIL_FROM=AutoInspecta <noreply@autoinspecta.it>
# Dove arrivano le notifiche per te (nuove lead, prenotazioni, ecc.)
ADMIN_NOTIFY_EMAIL=tu@esempio.it

# ---- Anti-spam ----
# Stringa casuale lunga: serve a salvare solo un hash dell'IP, non l'IP in chiaro.
IP_HASH_SALT=cambia-questa-stringa
